{
  "name": "gdebug",
  "displayName": "GDebug (Garry's Mod Lua)",
  "version": "0.1.0",
  "publisher": "gdebug",
  "repository": {
    "type": "git",
    "url": "https://github.com/weBj8/gdebug.git"
  },
  "description": "Attach debugger for Garry's Mod Lua via the gdebug native module",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js"
  ],
  "activationEvents": [
    "onDebugResolve:gdebug",
    "onDebugDynamicConfigurations:gdebug"
  ],
  "contributes": {
    "configuration": {
      "title": "GDebug",
      "properties": {
        "gdebug.adapterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the gdebug CLI executable (runs `gdebug dap`). Empty: use `gdebug` from PATH."
        }
      }
    },
    "breakpoints": [
      {
        "language": "lua"
      },
      {
        "language": "glua"
      }
    ],
    "debuggers": [
      {
        "type": "gdebug",
        "label": "GDebug (GMod Lua)",
        "languages": [
          "lua",
          "glua"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "endpointFile",
              "allowHookReplacement"
            ],
            "properties": {
              "endpointFile": {
                "type": "string",
                "description": "Path to the private endpoint descriptor written by the gdebug module (GDEBUG_SERVER_ENDPOINT_FILE / GDEBUG_CLIENT_ENDPOINT_FILE). Contains a secret token: keep it owner-only."
              },
              "endpoint": {
                "type": "string",
                "description": "Optional loopback host:port override, e.g. the local end of an SSH forward. The token still comes from endpointFile."
              },
              "realm": {
                "type": "string",
                "enum": [
                  "server",
                  "client"
                ],
                "description": "Asserts the target realm; attach fails if the endpoint is the other realm."
              },
              "allowHookReplacement": {
                "type": "boolean",
                "const": true,
                "description": "Required consent: attaching replaces the target's Lua debug hook (GMod's infinite-loop watchdog and profilers stop while attached). Restored on detach."
              },
              "stopOnAttach": {
                "type": "boolean",
                "default": false
              },
              "sourceMaps": {
                "type": "array",
                "description": "Explicit local/remote source roots; longest prefix wins. Without a match, paths under lua/ or gamemodes/ map by GMod's virtual root.",
                "items": {
                  "type": "object",
                  "required": [
                    "localRoot",
                    "remoteRoot"
                  ],
                  "properties": {
                    "localRoot": {
                      "type": "string"
                    },
                    "remoteRoot": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": [
          {
            "label": "GDebug: Attach to GMod server",
            "description": "Attach to a running GMod realm with the gdebug module",
            "body": {
              "name": "GMod server",
              "type": "gdebug",
              "request": "attach",
              "endpointFile": "^\"\\${env:HOME}/gdebug/server.json\"",
              "realm": "server",
              "sourceMaps": [
                {
                  "localRoot": "^\"\\${workspaceFolder}/lua\"",
                  "remoteRoot": "lua"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}